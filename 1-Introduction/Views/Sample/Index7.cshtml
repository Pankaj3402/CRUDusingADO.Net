<h1>Login Form using HTML Tags</h1>

<table>
    <tr>
        <td>Username:</td>
        <td><input type="text" name="username" /></td>
    </tr>
    <tr>
        <td>Password:</td>
        <td><input type="password" name="password" /></td>
    </tr>
    <tr>
        <td colspan="2"><input type="submit" value="Login" class="btn btn-primary"/></td>
    </tr>
</table>